  "verdicts_raised": [
    {
      "rank": 1,
      "title": "2025 was a genuine-only collapse, not a BVP trade-down of the wallet",
      "detail": "CY wallet €390K → €326K (−€64K). Genuine-only alone moved −€64K (100.8% of the drop). BVP only +€2.3K. Contested arena flat (~€47K)."
    },
    {
      "rank": 2,
      "title": "GPS peaked CY2024 at 42%, then fell to 35.4% in CY2025 — SPU −16%",
      "detail": "Wallet waterfall: GPS 37.7% (2023) → 42.0% (2024) → 35.4% (2025). SPU €104.9 → €88.4. Fleet was flat (~3.7k). This is numerator failure, not parc growth dilution."
    },
    {
      "rank": 3,
      "title": "FY2026 warranty ate ~30% of billing — commercial GPS is ~26%, not 37%",
      "detail": "FY26 net €346K includes €102K fiscal warranty (29.6%). Ex-warranty GPS on CY25 wallet = 26.1%. Headline 37.1% overstates commercial capture."
    },
    {
      "rank": 4,
      "title": "AIM is not the story — Priority target = low GPS × low PMS",
      "detail": "AIM high-risk only 2.1% of CY2025 sales (€7K). Eucon undercut exposure €86K is catalog risk, not observed leakage. leakage_band €42K. Don't open with street IAM fight — open with jobs not bought through AutoWallis."
    },
    {
      "rank": 5,
      "title": "Brake pads ARE a local BVP substitution — opposite of the wallet pattern",
      "detail": "Brake pad 2024→2025: genuine qty 53→33 (−38%), BVP qty 7→70; BVP € share 9%→63%. Total pad volume UP. Wallet-level 'BVP didn't save us' and category-level 'pads traded down' are both true — don't conflate."
    },
    {
      "rank": 6,
      "title": "PMS total capture ticked up (17.7%→19.1%) while GPS fell — different baskets",
      "detail": "Service-parts qty capture improved slightly; all-parts GPS wallet fell hard. Filters still ~35% network-relative weak on fuel; wear parts remain the € gap. Primary lens = total, not genuine-only."
    }
  ],
