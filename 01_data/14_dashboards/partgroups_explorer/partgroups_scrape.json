  "story": {
    "frame": {
      "title": "What this briefing tracks",
      "track": "Online shop prices versus our reference customer / workshop price — starting from the ISZE list, then adding distributor margin (+40%), then dealer margin (+27.5%).",
      "good": "What good looks like depends on the lens: IAM deep under our reference = pressure to watch; genuine sitting above IAM / above reference can be a deliberate OEM premium, not a miss. Below 1.0 = shop cheaper than our reference (competitive pressure / undercut). Near 1.0 = shop near our reference (neutral — not a target). Above 1.0 = shop dearer than our reference — can include a legitimate OEM / genuine premium.",
      "not_this": "Not Eucon PartsPool (that is the Competitive tab). Illustrative pressure is not a P&L write-off. Autodoc is not usable here — no real historical PN prices on disk.",
      "margin_plain": "Reference customer / workshop price = ISZE list → +40% distributor → +27.5% dealer (combined uplift ×1.785). Exact arithmetic is on hover / footnotes — not the headline.",
      "min_n_rule": "Part-family bars need at least 3 real PN hits; smaller samples are grey and labelled directional only."
    },
    "headline": "Online aftermarket quotes at about 56% of our reference customer price",
    "bullets": [
      "85% of real PN hits sit below our reference customer price",
      "€2,768,360 of CY2025 sales sits on the top undercut PNs (evidence list — not lost revenue)",
      "Illustrative price pressure on that list ≈ €1,660,663 (sales × gap to reference — directional, not a write-off)",
      "On KS dual-listed PNs (n=17): genuine median 0.92× reference vs AM 0.51× — channel gap ≈ 0.46",
      "No usable Autodoc PN prices on disk — current and archive CSVs are £2 / no_results placeholders (last stamp ~2026-05-30). Drift snapshots never included Autodoc. Do not treat Autodoc as a live competitive signal."
    ],
    "why_ks_gen_vs_am": "KS International lists the same ISZE part number with a genuine quote and an aftermarket quote. Comparing both to our reference customer price shows the UK catalogue channel gap — where genuine sits relative to reference (often a deliberate premium) vs how far IAM undercuts. It is not 'ISZE vs KS'; it is 'genuine vs IAM on one shelf'.",
    "definitions": {
      "reference_sellout": {
        "label": "Reference customer / workshop price",
        "formula": "ISZE list × 1.40 (distributor) × 1.275 (dealer) = list × 1.785",
        "plain": "Start from ISZE list, add distributor margin (+40%), then dealer margin (+27.5%). Management compare point — not raw list."
      },
      "price_index": {
        "label": "Price index",
        "formula": "shop € ÷ reference customer price €",
        "plain": "Below 1.0 = shop cheaper than our reference (pressure / undercut). Near 1.0 = shop near our reference (neutral — not a target). Above 1.0 = shop dearer — can be a legitimate OEM / genuine premium, not a failure."
      },
      "genuine_index": {
        "label": "Genuine vs reference",
        "formula": "KS genuine € ÷ reference customer price €",
        "plain": "Where the genuine catalogue line sits vs our reference on that PN. Above 1.0 can be a deliberate OEM premium."
      },
      "am_index": {
        "label": "Aftermarket vs reference",
        "formula": "shop aftermarket € ÷ reference customer price €",
        "plain": "Where the IAM / online aftermarket line sits vs our reference. Deep under 1.0 = competitive pressure."
      },
      "channel_spread": {
        "label": "Channel spread",
        "formula": "genuine index − aftermarket index",
        "plain": "Width of the genuine vs IAM gap on the same PN in the KS catalogue."
      },
      "price_pressure": {
        "label": "Illustrative price pressure €",
        "formula": "CY2025 sales € × (1 − aftermarket index) on undercut PNs",
        "plain": "Directional scale of billed sales where the shop sits below our reference — not a booked loss."
      }
    }
  },
