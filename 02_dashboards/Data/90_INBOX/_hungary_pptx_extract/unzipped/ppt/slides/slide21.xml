78040" cy="3026036"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr></p:pic><p:sp><p:nvSpPr><p:cNvPr id="9" name="Rectangle 8"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="7726679" y="1188720"/><a:ext cx="22000" cy="4892040"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:solidFill><a:srgbClr val="ECECEC"/></a:solidFill><a:ln><a:noFill/></a:ln></p:spPr><p:style><a:lnRef idx="1"><a:schemeClr val="accent1"/></a:lnRef><a:fillRef idx="3"><a:schemeClr val="accent1"/></a:fillRef><a:effectRef idx="2"><a:schemeClr val="accent1"/></a:effectRef><a:fontRef idx="minor"><a:schemeClr val="lt1"/></a:fontRef></p:style><p:txBody><a:bodyPr rtlCol="0" anchor="ctr"/><a:lstStyle/><a:p><a:pPr algn="ctr"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="10" name="TextBox 9"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="7927847" y="1234440"/><a:ext cx="3886200" cy="320040"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr algn="l"/><a:r><a:rPr sz="1200" b="1"><a:solidFill><a:srgbClr val="CC0E1E"/></a:solidFill><a:latin typeface="Calibri"/></a:rPr><a:t>TAKEAWAYS</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="11" name="TextBox 10"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="7927847" y="1691640"/><a:ext cx="3794760" cy="4343400"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr><a:lnSpc><a:spcPct val="125000"/></a:lnSpc><a:spcAft><a:spcPts val="1000"/></a:spcAft></a:pPr><a:r><a:rPr sz="1250" b="1"><a:solidFill><a:srgbClr val="CC0E1E"/></a:solidFill><a:latin typeface="Calibri"/></a:rPr><a:t>—  </a:t></a:r><a:r><a:rPr sz="1250"><a:solidFill><a:srgbClr val="1A1A1A"/></a:solidFill><a:latin typeface="Calibri"/></a:rPr><a:t>2025 is the only year since 2020 where Genuine and BVP move in opposite directions: Genuine EUR 341K → EUR 270K (-71K); BVP EUR 48K → EUR 52K (+4K). Every prior year they moved together.</a:t></a:r></a:p><a:p><a:pPr><a:lnSpc><a:spcPct val="125000"/></a:lnSpc><a:spcAft><a:spcPts val="1000"/></a:spcAft></a:pPr><a:r><a:rPr sz="1250" b="1"><a:solidFill><a:srgbClr val="CC0E1E"/></a:solidFill><a:latin typeface="Calibri"/></a:rPr><a:t>—  </a:t></a:r><a:r><a:rPr sz="1250"><a:solidFill><a:srgbClr val="1A1A1A"/></a:solidFill><a:latin typeface="Calibri"/></a:rPr><a:t>Not just a pricing effect: Genuine volume also fell (9,216 → 7,372 units) and breadth contracted (1,160 → 930 distinct genuine part numbers sold, -20%).</a:t></a:r></a:p><a:p><a:pPr><a:lnSpc><a:spcPct val="125000"/></a:lnSpc><a:spcAft><a:spcPts val="1000"/></a:spcAft></a:pPr><a:r><a:rPr sz="1250" b="1"><a:solidFill><a:srgbClr val="CC0E1E"/></a:solidFill><a:latin typeface="Calibri"/></a:rPr><a:t>—  </a:t></a:r><a:r><a:rPr sz="1250"><a:solidFill><a:srgbClr val="1A1A1A"/></a:solidFill><a:latin typeface="Calibri"/></a:rPr><a:t>BVP held up on every measure over the same year — units flat (4,036 → 4,052), SKU breadth grew (37 → 43) — so this isn't distributor-wide destocking, it's specific to Genuine.</a:t></a:r></a:p><a:p><a:pPr><a:lnSpc><a:spcPct val="125000"/></a:lnSpc><a:spcAft><a:spcPts val="1000"/></a:spcAft></a:pPr><a:r><a:rPr sz="1250" b="1"><a:solidFill><a:srgbClr val="CC0E1E"/></a:solidFill><a:latin typeface="Calibri"/></a:rPr><a:t>—  </a:t></a:r><a:r><a:rPr sz="1250"><a:solidFill><a:srgbClr val="1A1A1A"/></a:solidFill><a:latin typeface="Calibri"/></a:rPr><a:t>Worth cutting the 2025 genuine drop by category together before assuming it's competitive leakage — a concentrated cause (e.g. one model, one dealer) reads very differently from a broad-based one.</a:t></a:r></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>